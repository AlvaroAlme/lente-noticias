# Copia este archivo como ".env" y rellena tus claves.
# NUNCA subas el archivo ".env" real a git (ver .gitignore).

PORT=4000

# https://gnews.io/ -> regístrate y copia tu API key del dashboard
GNEWS_API_KEY=

# https://console.cloud.google.com/ -> habilita "Fact Check Tools API"
# y crea una API key en "APIs y servicios > Credenciales"
FACTCHECK_API_KEY=

# https://aistudio.google.com/apikey -> "Create API key" (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# https://twelvedata.com/pricing -> "Free" -> regístrate y copia la key
# del dashboard (800 peticiones/día)
TWELVEDATA_API_KEY=

# URL del frontend desplegado (para CORS). En local no hace falta.
CORS_ORIGIN=
